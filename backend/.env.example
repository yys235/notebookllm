# Application Settings
APP_NAME="Team1 Backend API"
APP_VERSION="0.1.0"
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/team1
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# Security
SECRET_KEY=change-this-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team1-backend

# AI Services
# For OpenAI:
AI_SERVICE_URL=https://api.openai.com/v1
AI_API_KEY=your-openai-api-key-here
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_LLM_PROVIDER=openai
AI_LLM_MODEL=gpt-4o-mini

# For Ollama (local):
# AI_SERVICE_URL=http://localhost:11434
# AI_EMBEDDING_PROVIDER=ollama
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_LLM_PROVIDER=ollama
# AI_LLM_MODEL=llama3.2
AI_SERVICE_TIMEOUT=30

# File Storage
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads
