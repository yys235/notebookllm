# ============================================================================
# Team1 Fullstack Application - Systemd Service Configuration
# ============================================================================
# This file defines the systemd service for the FastAPI backend.
#
# Installation:
#   sudo cp team1-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable team1-backend.service
#   sudo systemctl start team1-backend.service
# ============================================================================

[Unit]
Description=Team1 Backend API - FastAPI Application
Documentation=https://github.com/team1/team1-backend
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

# Start only after database is ready
AssertPathExists=/opt/team1/backend

[Service]
# User and group
User=team1
Group=team1

# Working directory
WorkingDirectory=/opt/team1/backend

# Environment
Environment="PATH=/opt/team1/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/team1/backend"

# Environment file (create this from .env.example)
EnvironmentFile=/opt/team1/backend/.env

# Service type (notify for readiness checks)
Type=notify
NotifyAccess=all

# Process management
ExecStart=/opt/team1/backend/venv/bin/uvicorn \
    main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --loop uvloop \
    --log-config /opt/team1/backend/logging.conf \
    --proxy-headers \
    --forwarded-allow-ips '*'

# Alternative for development with auto-reload
# ExecStart=/opt/team1/backend/venv/bin/uvicorn \
#     main:app \
#     --host 0.0.0.0 \
#     --port 8000 \
#     --reload \
#     --log-level debug

# Graceful shutdown
ExecStop=/bin/kill -TERM $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/team1/backend /opt/team1/uploads /var/log/team1 /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=team1-backend

# Process ID file
PIDFile=/var/run/team1-backend.pid

[Install]
WantedBy=multi-user.target
